#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "open3"
require "pathname"
require "time"

ROOT = Pathname(__dir__).join("..").realpath
TASK = ARGV[0] || "as-purge-embedded-images"
AI_EVALS_COMMIT = ENV.fetch("AI_EVALS_COMMIT", "8b4cab9165fc7878e4a2203f0966e45a1608cd09")
WRITEBOOK_COMMIT = ENV.fetch("WRITEBOOK_COMMIT", "e5563e260434c98425f3de80d45fddf0fdb76012")
TARGET_RUBY = ENV.fetch("RUBY_VERSION", "3.4.7")
PROVIDER = ENV.fetch("PROVIDER", "chatgpt:gpt-5.6-sol-xhigh")
ANALYST_MAX_TURNS = Integer(ENV.fetch("ANALYST_MAX_TURNS", "40"), 10)
TEST_AUTHOR_MAX_TURNS = Integer(ENV.fetch("TEST_AUTHOR_MAX_TURNS", "60"), 10)
DEVELOPER_MAX_TURNS = Integer(ENV.fetch("DEVELOPER_MAX_TURNS", "100"), 10)
MAX_OUTPUT_TOKENS = Integer(ENV.fetch("MAX_OUTPUT_TOKENS", "4096"), 10)
ANALYST_TIMEOUT_SECONDS = Integer(ENV.fetch("ANALYST_TIMEOUT_SECONDS", "1200"), 10)
TEST_AUTHOR_TIMEOUT_SECONDS = Integer(ENV.fetch("TEST_AUTHOR_TIMEOUT_SECONDS", "1800"), 10)
DEVELOPER_TIMEOUT_SECONDS = Integer(ENV.fetch("DEVELOPER_TIMEOUT_SECONDS", "1800"), 10)
CACHE_DIR = Pathname(ENV.fetch("CACHE_DIR", ROOT.join(".cache").to_s)).expand_path
RUNS_DIR = Pathname(ENV.fetch("RUNS_DIR", ROOT.join(".runs-staged").to_s)).expand_path
ANALYST_DIR = ROOT.join("agents/rails-state-analyst")
TEST_AUTHOR_DIR = ROOT.join("agents/rails-red-test-author")
DEVELOPER_DIR = ROOT.join("agents/rails-staged-developer")
STAMP = Time.now.strftime("%Y%m%d-%H%M%S")
RUN_DIR = RUNS_DIR.join("#{TASK}-#{STAMP}")
APP = RUN_DIR.join("app")
ART = RUN_DIR.join("artifacts")

$app_link_created = false
at_exit do
  system("sudo", "rm", "-f", "/app") if $app_link_created && File.symlink?("/app")
end

FileUtils.mkdir_p([CACHE_DIR, RUNS_DIR, RUN_DIR, ART])

def run!(*command, chdir: nil, out: nil, err: nil)
  options = {}
  options[:chdir] = chdir.to_s if chdir
  options[:out] = out if out
  options[:err] = err if err
  return if system(*command.map(&:to_s), **options)

  raise "command failed (#{Process.last_status&.exitstatus}): #{command.join(' ')}"
end

def capture!(*command, chdir: nil)
  options = {}
  options[:chdir] = chdir.to_s if chdir
  stdout, stderr, status = Open3.capture3(*command.map(&:to_s), **options)
  raise "command failed: #{command.join(' ')}\n#{stderr}" unless status.success?

  stdout
end

def clone_at(url, directory, commit)
  run!("git", "clone", url, directory) unless directory.join(".git").directory?
  system("git", "-C", directory.to_s, "fetch", "--quiet", "origin", commit)
  run!("git", "-C", directory, "checkout", "--quiet", "--detach", commit)
  run!("git", "-C", directory, "reset", "--quiet", "--hard", commit)
  run!("git", "-C", directory, "clean", "-qfdx")
end

clone_at("https://github.com/rails/ai-evals.git", CACHE_DIR.join("ai-evals"), AI_EVALS_COMMIT)
clone_at("https://github.com/basecamp/writebook.git", CACHE_DIR.join("writebook"), WRITEBOOK_COMMIT)

task_dir = CACHE_DIR.join("ai-evals/tasks", TASK)
instruction = task_dir.join("instruction.md")
verifier = task_dir.join("verification_test.rb")
abort "Unknown or incomplete task: #{TASK}" unless instruction.file? && verifier.file?

raw_instruction = instruction.binread
abort "instruction.md has no YAML front matter" unless raw_instruction.start_with?("---\n")
front_matter_end = raw_instruction.index("\n---\n", 4)
abort "instruction.md has unterminated YAML front matter" unless front_matter_end
prompt = raw_instruction.byteslice((front_matter_end + 5)..)
ART.join("prompt.md").binwrite(prompt)

run!("git", "clone", "--quiet", "--shared", CACHE_DIR.join("writebook"), APP)
run!("git", "-C", APP, "checkout", "--quiet", "--detach", WRITEBOOK_COMMIT)
run!("git", "-C", APP, "reset", "--quiet", "--hard", WRITEBOOK_COMMIT)
run!("git", "-C", APP, "clean", "-qfdx")
environment_patch = task_dir.join("environment.patch")
if environment_patch.file?
  run!("git", "-C", APP, "apply", "--check", environment_patch)
  run!("git", "-C", APP, "apply", environment_patch)
end
run!("git", "-C", APP, "config", "user.name", "Rails lifecycle harness")
run!("git", "-C", APP, "config", "user.email", "rails-lifecycle@invalid")
run!("git", "-C", APP, "add", "-A")
run!("git", "-C", APP, "commit", "--quiet", "--allow-empty", "-m", "Freeze #{TASK} environment")

unless system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bundle", "check", chdir: APP.to_s)
  run!("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bundle", "install", chdir: APP)
end
run!("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "db:prepare", chdir: APP,
     out: File::NULL, err: File::NULL)

agent_dirs = [ANALYST_DIR, TEST_AUTHOR_DIR, DEVELOPER_DIR]
ART.join("resource-mode.txt").write("staged agents: #{agent_dirs.join(', ')}\n")
agent_files = agent_dirs.flat_map { |dir| dir.glob("**/*").select(&:file?) }.sort
ART.join("frozen-agent-tool.sha256").write(
  agent_files.map { |path| "#{Digest::SHA256.file(path).hexdigest}  #{path}\n" }.join
)

baseline = capture!("git", "-C", APP, "rev-parse", "HEAD").strip
ART.join("baseline.txt").write("#{baseline}\n")

def run_agent_phase(name:, agent_dir:, max_turns:, timeout_seconds:, prompt:)
  phase = ART.join("phases", name)
  phase.mkpath
  ask = [
    "term-llm", "ask",
    "--session-db", phase.join("sessions.db").to_s,
    "--agent", agent_dir.to_s,
    "--provider", PROVIDER,
    "--yolo", "--skills", "none", "--json", "--stats",
    "--max-turns", max_turns.to_s, "--max-output-tokens", MAX_OUTPUT_TOKENS.to_s,
    prompt.dup.force_encoding("UTF-8")
  ]

  exit_code = nil
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  File.open(phase.join("raw.jsonl"), "wb") do |stdout|
    File.open(phase.join("stderr.txt"), "wb") do |stderr|
      pid = Process.spawn(*ask, chdir: APP.to_s, out: stdout, err: stderr, pgroup: true)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
      loop do
        waited = Process.waitpid2(pid, Process::WNOHANG)
        if waited
          exit_code = waited.last.exitstatus || 1
          break
        end
        if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
          Process.kill("TERM", -pid) rescue nil
          sleep 2
          Process.kill("KILL", -pid) rescue nil
          Process.wait(pid) rescue nil
          exit_code = 124
          break
        end
        sleep 0.2
      end
    end
  end
  phase.join("ask-exit.txt").write("#{exit_code}\n")
  phase.join("ask-wall-seconds.txt").write(
    format("%.3f\n", Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)
  )

  session_db = phase.join("sessions.db")
  File.open(phase.join("session.txt"), "wb") do |file|
    system("term-llm", "sessions", "show", "--session-db", session_db.to_s, "1",
           out: file, err: [:child, :out])
  end
  session_id = phase.join("session.txt").read[/^Session: (.+)$/, 1]
  if session_id
    system("term-llm", "sessions", "show", "--session-db", session_db.to_s, "--json", "1",
           out: phase.join("session.json").to_s, err: phase.join("session-json.stderr").to_s)
    system("term-llm", "sessions", "export", "--session-db", session_db.to_s,
           "--include-system", "--include-reasoning", session_id, phase.join("session.md").to_s,
           out: phase.join("session-export.txt").to_s, err: [:child, :out])
  end
  exit_code
end

def workspace_paths
  capture!("git", "-C", APP, "status", "--porcelain", "--untracked-files=all").lines.filter_map do |line|
    path = line[3..]&.strip
    path unless path.nil? || path.empty?
  end
end

run_agent_phase(
  name: "01-state-analysis", agent_dir: ANALYST_DIR,
  max_turns: ANALYST_MAX_TURNS, timeout_seconds: ANALYST_TIMEOUT_SECONDS, prompt: prompt
)
analysis_path = APP.join(".term-llm/state-analysis.md")
abort "state analyst did not create #{analysis_path}" unless analysis_path.file? && !analysis_path.empty?
analyst_leaks = workspace_paths.reject { |path| path.start_with?(".term-llm/") }
ART.join("analyst-boundary.txt").write(analyst_leaks.join("\n"))
abort "state analyst changed forbidden paths: #{analyst_leaks.join(', ')}" unless analyst_leaks.empty?

run_agent_phase(
  name: "02-red-test-author", agent_dir: TEST_AUTHOR_DIR,
  max_turns: TEST_AUTHOR_MAX_TURNS, timeout_seconds: TEST_AUTHOR_TIMEOUT_SECONDS, prompt: prompt
)
test_author_leaks = workspace_paths.reject { |path| path.start_with?("test/", ".term-llm/") }
ART.join("test-author-boundary.txt").write(test_author_leaks.join("\n"))
abort "test author changed forbidden paths: #{test_author_leaks.join(', ')}" unless test_author_leaks.empty?
changed_tests = (
  capture!("git", "-C", APP, "diff", "--name-only", baseline, "--", "test").lines.map(&:strip) +
  capture!("git", "-C", APP, "ls-files", "--others", "--exclude-standard", "--", "test").lines.map(&:strip)
).reject(&:empty?).uniq.sort
abort "test author left no changed tests" if changed_tests.empty?
APP.join(".term-llm/changed-tests.txt").write(changed_tests.join("\n") + "\n")

red_exit = nil
File.open(ART.join("red-suite.txt"), "wb") do |stdout|
  system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "test", *changed_tests,
         chdir: APP.to_s, out: stdout, err: [:child, :out])
  red_exit = Process.last_status&.exitstatus || 1
end
ART.join("red-suite-exit.txt").write("#{red_exit}\n")
red_output = ART.join("red-suite.txt").read
summaries = red_output.scan(/(\d+) failures, (\d+) errors/)
abort "changed tests did not produce a parseable red test summary" if summaries.empty?
failures, errors = summaries.last.map(&:to_i)
abort "changed tests must fail assertions without errors (failures=#{failures}, errors=#{errors}, exit=#{red_exit})" unless red_exit != 0 && failures.positive? && errors.zero?

run!("git", "-C", APP, "add", "--", "test")
run!("git", "-C", APP, "commit", "--quiet", "-m", "Freeze independently authored red tests")
test_baseline = capture!("git", "-C", APP, "rev-parse", "HEAD").strip
ART.join("test-baseline.txt").write("#{test_baseline}\n")

run_agent_phase(
  name: "03-production-developer", agent_dir: DEVELOPER_DIR,
  max_turns: DEVELOPER_MAX_TURNS, timeout_seconds: DEVELOPER_TIMEOUT_SECONDS, prompt: prompt
)
developer_test_changes = capture!("git", "-C", APP, "status", "--porcelain", "--", "test")
ART.join("developer-test-boundary.txt").write(developer_test_changes)
abort "developer changed protected tests" unless developer_test_changes.empty?
production_paths = capture!("git", "-C", APP, "diff", "--name-only", test_baseline, "--", ".", ":(exclude)test", ":(exclude).term-llm").lines.map(&:strip).reject(&:empty?)
production_paths.concat(capture!("git", "-C", APP, "ls-files", "--others", "--exclude-standard").lines.map(&:strip).reject { |path| path.start_with?("test/", ".term-llm/") })
production_paths.uniq!
ART.join("developer-production-paths.txt").write(production_paths.join("\n") + "\n")
abort "developer left no production change" if production_paths.empty?

focused_exit = nil
File.open(ART.join("focused-green-suite.txt"), "wb") do |stdout|
  system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "test", *changed_tests,
         chdir: APP.to_s, out: stdout, err: [:child, :out])
  focused_exit = Process.last_status&.exitstatus || 1
end
ART.join("focused-green-suite-exit.txt").write("#{focused_exit}\n")
abort "independently authored tests are not green after implementation" unless focused_exit.zero?

File.open(ART.join("solver.diff"), "wb") do |file|
  run!("git", "-C", APP, "diff", "--binary", baseline, "--", ".", ":(exclude).term-llm", out: file)
end
File.open(ART.join("solver-diff-stat.txt"), "wb") do |file|
  run!("git", "-C", APP, "diff", "--stat", baseline, "--", ".", ":(exclude).term-llm", out: file)
end
ART.join("solver-status.txt").write(capture!("git", "-C", APP, "status", "--short", "--branch"))

# Return HEAD to the original environment while preserving the complete staged
# workspace diff, then remove solver-authored protected surfaces before grading.
run!("git", "-C", APP, "reset", "--quiet", baseline)
protected_paths = ["test", "bin", "config/environments/test.rb"]
File.open(ART.join("grading-restore.txt"), "wb") do |log|
  run!("git", "-C", APP, "restore", "--source", baseline, "--", *protected_paths, out: log, err: [:child, :out])
  run!("git", "-C", APP, "clean", "-fd", "--", *protected_paths, out: log, err: [:child, :out])
end
protected_status = capture!("git", "-C", APP, "status", "--short", "--", *protected_paths)
ART.join("grading-protected-status.txt").write(protected_status)
abort "protected grading surfaces differ from baseline after restore" unless protected_status.empty?

visible_exit = nil
File.open(ART.join("visible-suite.txt"), "wb") do |stdout|
  system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "test",
         chdir: APP.to_s, out: stdout, err: [:child, :out])
  visible_exit = Process.last_status&.exitstatus || 1
end
ART.join("visible-suite-exit.txt").write("#{visible_exit}\n")

final_exit = 0
# Concurrent matrix workers may overlap model calls, but the published verifier
# requires the process-global /app path. Serialize only that grading section.
File.open("/tmp/rails-ai-lifecycle-harness-verifier.lock", File::RDWR | File::CREAT, 0o644) do |lock|
  lock.flock(File::LOCK_EX)
  ART.join("verifier-lock.txt").write("acquired #{Time.now.utc.iso8601(6)}\n")
  if File.exist?("/app") || File.symlink?("/app")
    message = "Skipping published verifier: /app already exists; refusing to replace it.\n"
    warn message
    ART.join("verifier.txt").write(message)
    ART.join("verifier-exit.txt").write("SKIPPED_APP_EXISTS\n")
    final_exit = 3
  else
    run!("sudo", "ln", "-s", APP, "/app")
    $app_link_created = true
    verifier_exit = nil
    File.open(ART.join("verifier.txt"), "wb") do |stdout|
      system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "ruby", verifier.to_s,
             chdir: APP.to_s, out: stdout, err: [:child, :out])
      verifier_exit = Process.last_status&.exitstatus || 1
    end
    ART.join("verifier-exit.txt").write("#{verifier_exit}\n")
    final_exit = 1 unless verifier_exit.zero?
    run!("sudo", "rm", "-f", "/app")
    $app_link_created = false
  end
end

puts "\nRun directory: #{RUN_DIR}"
puts "\nProduction diff:"
puts ART.join("solver-diff-stat.txt").read
puts "\nVisible suite:"
puts ART.join("visible-suite.txt").read.lines.last(8).join
puts "\nPublished verifier:"
puts ART.join("verifier.txt").read.lines.last(12).join

exit final_exit
