#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "open3"
require "pathname"
require "time"

ROOT = Pathname(__dir__).join("..").realpath
TASK = ARGV[0] || "as-purge-embedded-images"
AI_EVALS_COMMIT = ENV.fetch("AI_EVALS_COMMIT", "8b4cab9165fc7878e4a2203f0966e45a1608cd09")
WRITEBOOK_COMMIT = ENV.fetch("WRITEBOOK_COMMIT", "e5563e260434c98425f3de80d45fddf0fdb76012")
TARGET_RUBY = ENV.fetch("RUBY_VERSION", "3.4.7")
PROVIDER = ENV.fetch("PROVIDER", "chatgpt:gpt-5.6-sol-xhigh")
MAX_TURNS = Integer(ENV.fetch("MAX_TURNS", "30"), 10)
MAX_OUTPUT_TOKENS = Integer(ENV.fetch("MAX_OUTPUT_TOKENS", "4096"), 10)
ASK_TIMEOUT_SECONDS = Integer(ENV.fetch("ASK_TIMEOUT_SECONDS", "600"), 10)
CACHE_DIR = Pathname(ENV.fetch("CACHE_DIR", ROOT.join(".cache").to_s)).expand_path
RUNS_DIR = Pathname(ENV.fetch("RUNS_DIR", ROOT.join(".runs").to_s)).expand_path
AGENT_DIR = Pathname(ENV.fetch("AGENT_DIR", ROOT.join("agents/rails-lifecycle-developer").to_s)).expand_path
SUBAGENT_SOURCE = AGENT_DIR.join("subagents")
STAMP = Time.now.strftime("%Y%m%d-%H%M%S")
RUN_DIR = RUNS_DIR.join("#{TASK}-#{STAMP}")
APP = RUN_DIR.join("app")
ART = RUN_DIR.join("artifacts")

$app_link_created = false
at_exit do
  system("sudo", "rm", "-f", "/app") if $app_link_created && File.symlink?("/app")
end

FileUtils.mkdir_p([CACHE_DIR, RUNS_DIR, RUN_DIR, ART])

def run!(*command, chdir: nil, out: nil, err: nil)
  options = {}
  options[:chdir] = chdir.to_s if chdir
  options[:out] = out if out
  options[:err] = err if err
  return if system(*command.map(&:to_s), **options)

  raise "command failed (#{Process.last_status&.exitstatus}): #{command.join(' ')}"
end

def capture!(*command, chdir: nil)
  options = {}
  options[:chdir] = chdir.to_s if chdir
  stdout, stderr, status = Open3.capture3(*command.map(&:to_s), **options)
  raise "command failed: #{command.join(' ')}\n#{stderr}" unless status.success?

  stdout
end

def clone_at(url, directory, commit)
  run!("git", "clone", url, directory) unless directory.join(".git").directory?
  system("git", "-C", directory.to_s, "fetch", "--quiet", "origin", commit)
  run!("git", "-C", directory, "checkout", "--quiet", "--detach", commit)
  run!("git", "-C", directory, "reset", "--quiet", "--hard", commit)
  run!("git", "-C", directory, "clean", "-qfdx")
end

clone_at("https://github.com/rails/ai-evals.git", CACHE_DIR.join("ai-evals"), AI_EVALS_COMMIT)
clone_at("https://github.com/basecamp/writebook.git", CACHE_DIR.join("writebook"), WRITEBOOK_COMMIT)

task_dir = CACHE_DIR.join("ai-evals/tasks", TASK)
instruction = task_dir.join("instruction.md")
verifier = task_dir.join("verification_test.rb")
abort "Unknown or incomplete task: #{TASK}" unless instruction.file? && verifier.file?

raw_instruction = instruction.binread
abort "instruction.md has no YAML front matter" unless raw_instruction.start_with?("---\n")
front_matter_end = raw_instruction.index("\n---\n", 4)
abort "instruction.md has unterminated YAML front matter" unless front_matter_end
prompt = raw_instruction.byteslice((front_matter_end + 5)..)
ART.join("prompt.md").binwrite(prompt)

run!("git", "clone", "--quiet", "--shared", CACHE_DIR.join("writebook"), APP)
run!("git", "-C", APP, "checkout", "--quiet", "--detach", WRITEBOOK_COMMIT)
run!("git", "-C", APP, "reset", "--quiet", "--hard", WRITEBOOK_COMMIT)
run!("git", "-C", APP, "clean", "-qfdx")
environment_patch = task_dir.join("environment.patch")
if environment_patch.file?
  run!("git", "-C", APP, "apply", "--check", environment_patch)
  run!("git", "-C", APP, "apply", environment_patch)
end
run!("git", "-C", APP, "config", "user.name", "Rails lifecycle harness")
run!("git", "-C", APP, "config", "user.email", "rails-lifecycle@invalid")
run!("git", "-C", APP, "add", "-A")
run!("git", "-C", APP, "commit", "--quiet", "--allow-empty", "-m", "Freeze #{TASK} environment")

unless system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bundle", "check", chdir: APP.to_s)
  run!("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bundle", "install", chdir: APP)
end
run!("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "db:prepare", chdir: APP,
     out: File::NULL, err: File::NULL)

ART.join("resource-mode.txt").write("first-class custom tool bundled in agent: #{AGENT_DIR}\n")
agent_files = AGENT_DIR.glob("**/*").select(&:file?).sort
ART.join("frozen-agent-tool.sha256").write(
  agent_files.map { |path| "#{Digest::SHA256.file(path).hexdigest}  #{path}\n" }.join
)

baseline = capture!("git", "-C", APP, "rev-parse", "HEAD").strip
ART.join("baseline.txt").write("#{baseline}\n")

abort "bundled subagents missing: #{SUBAGENT_SOURCE}" unless SUBAGENT_SOURCE.directory?
runtime_agents = APP.join("term-llm-agents")
runtime_agents.mkpath
SUBAGENT_SOURCE.children.each { |source| FileUtils.cp_r(source, runtime_agents) }
ART.join("runtime-subagents.txt").write(
  runtime_agents.children.sort.map { |path| "#{path.basename}\n" }.join
)

ask = [
  "term-llm", "ask",
  "--session-db", ART.join("sessions.db").to_s,
  "--agent", AGENT_DIR.to_s,
  "--provider", PROVIDER,
  "--yolo", "--skills", "none", "--json", "--stats",
  "--max-turns", MAX_TURNS.to_s, "--max-output-tokens", MAX_OUTPUT_TOKENS.to_s,
  prompt.force_encoding("UTF-8")
]

ask_exit = nil
ask_started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
File.open(ART.join("raw.jsonl"), "wb") do |stdout|
  File.open(ART.join("stderr.txt"), "wb") do |stderr|
    pid = Process.spawn(*ask, chdir: APP.to_s, out: stdout, err: stderr, pgroup: true)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + ASK_TIMEOUT_SECONDS
    loop do
      waited = Process.waitpid2(pid, Process::WNOHANG)
      if waited
        ask_exit = waited.last.exitstatus || 1
        break
      end
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        Process.kill("TERM", -pid) rescue nil
        sleep 2
        Process.kill("KILL", -pid) rescue nil
        Process.wait(pid) rescue nil
        ask_exit = 124
        break
      end
      sleep 0.2
    end
  end
end
ART.join("ask-exit.txt").write("#{ask_exit}\n")
ART.join("ask-wall-seconds.txt").write(
  format("%.3f\n", Process.clock_gettime(Process::CLOCK_MONOTONIC) - ask_started)
)

session_db = ART.join("sessions.db")
File.open(ART.join("session.txt"), "wb") do |file|
  system("term-llm", "sessions", "show", "--session-db", session_db.to_s, "1", out: file, err: [:child, :out])
end
session_id = ART.join("session.txt").read[/^Session: (.+)$/, 1]
if session_id
  system("term-llm", "sessions", "show", "--session-db", session_db.to_s, "--json", "1",
         out: ART.join("session.json").to_s, err: ART.join("session-json.stderr").to_s)
  system("term-llm", "sessions", "export", "--session-db", session_db.to_s,
         "--include-system", "--include-reasoning", session_id, ART.join("session.md").to_s,
         out: ART.join("session-export.txt").to_s, err: [:child, :out])
end

FileUtils.rm_rf(runtime_agents)
File.open(ART.join("solver.diff"), "wb") do |file|
  run!("git", "-C", APP, "diff", "--binary", baseline, "--", ".", ":(exclude).term-llm", out: file)
end
File.open(ART.join("solver-diff-stat.txt"), "wb") do |file|
  run!("git", "-C", APP, "diff", "--stat", baseline, "--", ".", ":(exclude).term-llm", out: file)
end
ART.join("solver-status.txt").write(capture!("git", "-C", APP, "status", "--short", "--branch"))

# Match the published grading protocol: preserve the solver diff above, then
# restore protected surfaces so self-authored tests cannot affect the score.
protected_paths = ["test", "bin", "config/environments/test.rb"]
File.open(ART.join("grading-restore.txt"), "wb") do |log|
  run!("git", "-C", APP, "restore", "--source", baseline, "--", *protected_paths, out: log, err: [:child, :out])
  run!("git", "-C", APP, "clean", "-fd", "--", *protected_paths, out: log, err: [:child, :out])
end
protected_status = capture!("git", "-C", APP, "status", "--short", "--", *protected_paths)
ART.join("grading-protected-status.txt").write(protected_status)
abort "protected grading surfaces differ from baseline after restore" unless protected_status.empty?

visible_exit = nil
File.open(ART.join("visible-suite.txt"), "wb") do |stdout|
  system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "bin/rails", "test",
         chdir: APP.to_s, out: stdout, err: [:child, :out])
  visible_exit = Process.last_status&.exitstatus || 1
end
ART.join("visible-suite-exit.txt").write("#{visible_exit}\n")

final_exit = 0
# Concurrent matrix workers may overlap model calls, but the published verifier
# requires the process-global /app path. Serialize only that grading section.
File.open("/tmp/rails-ai-lifecycle-harness-verifier.lock", File::RDWR | File::CREAT, 0o644) do |lock|
  lock.flock(File::LOCK_EX)
  ART.join("verifier-lock.txt").write("acquired #{Time.now.utc.iso8601(6)}\n")
  if File.exist?("/app") || File.symlink?("/app")
    message = "Skipping published verifier: /app already exists; refusing to replace it.\n"
    warn message
    ART.join("verifier.txt").write(message)
    ART.join("verifier-exit.txt").write("SKIPPED_APP_EXISTS\n")
    final_exit = 3
  else
    run!("sudo", "ln", "-s", APP, "/app")
    $app_link_created = true
    verifier_exit = nil
    File.open(ART.join("verifier.txt"), "wb") do |stdout|
      system("mise", "x", "ruby@#{TARGET_RUBY}", "--", "ruby", verifier.to_s,
             chdir: APP.to_s, out: stdout, err: [:child, :out])
      verifier_exit = Process.last_status&.exitstatus || 1
    end
    ART.join("verifier-exit.txt").write("#{verifier_exit}\n")
    final_exit = 1 unless verifier_exit.zero?
    run!("sudo", "rm", "-f", "/app")
    $app_link_created = false
  end
end

puts "\nRun directory: #{RUN_DIR}"
puts "\nProduction diff:"
puts ART.join("solver-diff-stat.txt").read
puts "\nVisible suite:"
puts ART.join("visible-suite.txt").read.lines.last(8).join
puts "\nPublished verifier:"
puts ART.join("verifier.txt").read.lines.last(12).join

exit final_exit
