#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "open3"
require "pathname"

root = Pathname(__dir__).join("..").realpath
app = Pathname(ARGV[0] || ".").expand_path
output = Pathname(ARGV[1] || app.join(".term-llm/rails-lifecycle-audit.md")).expand_path
graph = Pathname(output.to_s.sub(/\.md\z/, ".json"))
scanner = root.join("resources/rails_lifecycle_graph.rb")
reference = root.join("resources/rails-lifecycle-reference.md")
process = root.join("resources/rails-lifecycle-process.md")

FileUtils.mkdir_p(output.dirname)
json, stderr, status = Open3.capture3("ruby", scanner.to_s, chdir: app.to_s)
abort(stderr.empty? ? "lifecycle scanner failed" : stderr) unless status.success?
graph.write(json)
output.write(<<~MARKDOWN)
  # Supplied Rails lifecycle audit resource

  Generic frozen lifecycle reference + deterministic repository graph + process schema.

  #{reference.read}

  ---

  #{process.read}

  ---

  # Deterministic current-repository graph packet

  ```json
  #{json}```
MARKDOWN

[scanner, reference, process, graph, output].each do |path|
  puts "#{Digest::SHA256.file(path).hexdigest}  #{path}"
end
